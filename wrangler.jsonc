// Cloudflare Workers met alleen statische bestanden (opvolger van Pages).
// `npm run build` maakt `_site`; de workflow pakt daar het geteste artefact uit.
{
  "name": "ishetalafgelast",
  "compatibility_date": "2026-11-01",
  // Alleen www.ishetalafgelast.nl (custom domain in Cloudflare); geen tweede
  // publieke kopie op workers.dev of preview-URL's.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./_site",
    "not_found_handling": "404-page"
  }
}
